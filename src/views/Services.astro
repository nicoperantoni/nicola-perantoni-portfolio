---
// Servizi: nome grande e descrizione. Sui dispositivi touch la foto del
// servizio è nella riga; col mouse no.
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import { photo } from '../data/photos';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang).services;
---

<BaseLayout lang={lang} page="services" bodyClass="page-sub">
  <main class="sub-body">
    <ol class="rows svc-list">
      {
        t.items.map((s, i) => (
          <li class="svc">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p>{s.title}</p>
              <p class="svc-desc">{s.desc}</p>
              <Picture
                class="svc-thumb"
                src={photo(s.photo)}
                alt=""
                widths={[360, 520, 720]}
                sizes="min(60vw, 260px)"
                formats={['avif']}
                fallbackFormat="webp"
              />
            </div>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>

<script>
  import '../lib/subpage';
</script>
