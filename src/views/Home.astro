---
// Home, condivisa tra "/" e "/en/": titolo a tutta larghezza e scala di foto
// (lib/scale.ts). Al primo ingresso nella sessione parte il loader
// (lib/intro.ts); arrivando dal menu la pagina sale insieme al titolo
// (lib/transition.ts); altrimenti compare subito.
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import { HOME_PHOTOS, SCALE_WIDTHS, SCALE_SIZES, photo } from '../data/photos';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.home;
const n = HOME_PHOTOS.length;
const [word1, word2] = t.site.name.split(' ');
---

<BaseLayout lang={lang} page="home" bodyClass="page-home">
  <main class="scale" id="scale" aria-label={h.stageAria}>
    {
      HOME_PHOTOS.map((name, i) => (
        <figure class="scale-item">
          <Picture
            src={photo(name)}
            alt={h.photoAlt(i + 1, n)}
            widths={SCALE_WIDTHS}
            sizes={SCALE_SIZES}
            formats={['avif']}
            fallbackFormat="webp"
            loading="eager"
            decoding="async"
            draggable="false"
          />
        </figure>
      ))
    }
  </main>

  <nav class="scale-arrows" aria-label={h.arrowsAria}>
    <button class="scale-arrow" id="scale-prev" type="button" aria-label={h.prev}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
    </button>
    <button class="scale-arrow" id="scale-next" type="button" aria-label={h.next}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
    </button>
  </nav>

  <!-- Loader del primo ingresso (lib/intro.ts): visibile solo con html.is-intro. -->
  <div class="intro" id="intro" aria-hidden="true" slot="after">
    <div class="intro-title">
      <div class="intro-word" id="intro-start">{[...word1].map((c) => <span class="intro-letter">{c}</span>)}</div>
      <div class="intro-box" id="intro-box">
        <div class="intro-box-inner">
          <div class="intro-grow" id="intro-grow"><div class="intro-wrap" id="intro-wrap"></div></div>
        </div>
      </div>
      <div class="intro-word" id="intro-end">{[...word2].map((c) => <span class="intro-letter">{c}</span>)}</div>
    </div>
  </div>
</BaseLayout>

<script>
  import { initScale } from '../lib/scale';
  import { isIntro, runIntro } from '../lib/intro';
  import { initArrival, isArriving } from '../lib/transition';
  import { initMenu, showMenuButton } from '../lib/menu';
  import { fillContacts } from '../lib/contacts';
  import { fitWidth, fontsFor } from '../lib/fit';

  const headline = document.getElementById('headline')!;
  const head = document.querySelector<HTMLElement>('.site-head')!;
  const scale = initScale(document.getElementById('scale')!, head);
  initMenu();
  fillContacts();

  // A font caricato: titolo a tutta larghezza misurato sulla parola, poi la
  // scala (la sua altezza dipende dalla testata).
  const place = () => { scale.measure(); scale.render(); };
  place();
  const fonts = fontsFor([headline, document.querySelector('.intro-letter') ?? headline]).then(() => {
    fitWidth(headline);
    place();
  });

  // Ingresso nella pagina; alla fine, sotto il titolo già comparso, scende il
  // tasto Menu.
  const entered = isIntro()
    ? runIntro(scale, fonts)
    : isArriving()
      ? initArrival({ ready: fonts, layout: place }).then(scale.enable)
      : fonts.then(scale.enable);
  entered.then(() => showMenuButton());
</script>
