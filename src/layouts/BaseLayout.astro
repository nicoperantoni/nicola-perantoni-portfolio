---
// <head> con meta SEO per pagina e lingua, testata (tasto Menu, lingua,
// titolo) e menu a tutto schermo condivisi da tutte le pagine.
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { Font } from 'astro:assets';
import TopBar from '../components/TopBar.astro';
import Menu from '../components/Menu.astro';
import { useTranslations, pagePath, otherLocale } from '../i18n/utils';
import { locales, type Locale, type Page } from '../i18n/ui';

interface Props {
  lang: Locale;
  page: Page;
  /** Classe del <body> ("page-sub" nelle pagine interne). */
  bodyClass?: string;
}

const { lang, page, bodyClass } = Astro.props;
const t = useTranslations(lang);
const seo = t.seo.pages[page];
const headline = page === 'home' ? t.site.name : t[page].title;
const isHome = page === 'home';

const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(pagePath(page, lang));
const ogImage = abs('/og-image.jpg');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: t.site.name,
  description: t.seo.pages.home.description,
  image: ogImage,
  url: abs('/'),
  email: 'nicola@devastante.studio',
  areaServed: 'IT',
  address: { '@type': 'PostalAddress', addressLocality: 'Verona', addressCountry: 'IT' },
  sameAs: ['https://instagram.com/devastante.studio/'],
  founder: { '@type': 'Person', name: 'Nicola Perantoni', jobTitle: t.seo.jobTitle },
  makesOffer: t.seo.offers.map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content="Nicola Perantoni" />
    <meta name="theme-color" content="#f4f4f4" />
    <!-- Riserva dei diritti di estrazione di testi e dati (TDM, direttiva UE
         2019/790, art. 4), anche per addestrare modelli di AI: vale per tutto
         il sito, dichiarata anche in /.well-known/tdmrep.json. -->
    <meta name="tdm-reservation" content="1" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(pagePath(page, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(pagePath(page, 'it'))} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.seo.ogLocale} />
    <meta property="og:locale:alternate" content={useTranslations(otherLocale(lang)).seo.ogLocale} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={t.seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {page === 'home' && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Font serviti dal sito: Space Grotesk (titoli) e Archivo (testo). -->
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-text" preload={[{ weight: 400 }, { weight: 500 }]} />
    <slot name="head" />

    <!-- Loader, deciso prima che la pagina compaia: parte arrivando da una
         voce del menu (su ogni pagina) e al primo ingresso in Home nella
         sessione; tornando in Home in altro modo non riparte. -->
    <script is:inline define:vars={{ isHome }}>
      (function () {
        var c = document.documentElement.classList;
        try {
          var t = JSON.parse(sessionStorage.getItem('sd-transition') || 'null');
          sessionStorage.removeItem('sd-transition');
          if (t && Date.now() - t.ts < 15000) {
            c.add('is-loading', 'via-menu');
            window.__sdLabel = String(t.label || '');
            if (typeof t.y === 'number') window.__sdY = t.y;
          } else if (isHome && !sessionStorage.getItem('sd-intro')) {
            c.add('is-loading');
          }
        } catch (e) {
          if (isHome) c.add('is-loading');
        }
      })();
    </script>
  </head>
  <body class={bodyClass} data-page={page}>
    <div class="loader" id="loader" aria-hidden="true">
      <div class="loader-bar" id="loader-bar"></div>
      <p class="loader-word" id="word-dark">{headline}</p>
      <p class="loader-word on-bar" id="word-light">{headline}</p>
    </div>
    <script is:inline>
      // Arrivando dal menu la parola riparte dalla voce scelta, alla stessa
      // altezza a cui era nel menu.
      if (window.__sdLabel) {
        document.getElementById('word-dark').textContent = window.__sdLabel;
        document.getElementById('word-light').textContent = window.__sdLabel;
        if (typeof window.__sdY === 'number') {
          document.getElementById('word-dark').style.top = window.__sdY + 'px';
          document.getElementById('word-light').style.top = window.__sdY + 'px';
        }
      }
    </script>
    <div class:list={[isHome && 'shell']}>
      <header class="site-head">
        <TopBar lang={lang} />
        <h1 class="headline" id="headline">{headline}</h1>
      </header>
      <slot />
    </div>
    <Menu lang={lang} page={page} />
    <slot name="after" />
    <Analytics />
  </body>
</html>
