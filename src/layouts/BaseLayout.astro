---
// <head> con meta SEO per pagina e lingua, testata (tasto Menu, lingua,
// titolo) e menu a tutto schermo condivisi da tutte le pagine.
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { Font } from 'astro:assets';
import TopBar from '../components/TopBar.astro';
import Menu from '../components/Menu.astro';
import { useTranslations, pagePath, otherLocale } from '../i18n/utils';
import { locales, type Locale, type Page } from '../i18n/ui';

interface Props {
  lang: Locale;
  page: Page;
  /** Classe del <body> ("page-home" o "page-sub"). */
  bodyClass?: string;
}

const { lang, page, bodyClass } = Astro.props;
const t = useTranslations(lang);
const seo = t.seo.pages[page];
const headline = page === 'home' ? t.site.name : t[page].title;
const isHome = page === 'home';

const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(pagePath(page, lang));
const ogImage = abs('/og-image.jpg');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: t.site.name,
  description: t.seo.pages.home.description,
  image: ogImage,
  url: abs('/'),
  email: 'nicola@devastante.studio',
  areaServed: 'IT',
  address: { '@type': 'PostalAddress', addressLocality: 'Verona', addressCountry: 'IT' },
  sameAs: ['https://instagram.com/devastante.studio/'],
  founder: { '@type': 'Person', name: 'Nicola Perantoni', jobTitle: t.seo.jobTitle },
  makesOffer: t.seo.offers.map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content="Nicola Perantoni" />
    <meta name="theme-color" content="#f4f4f4" />
    <!-- Riserva dei diritti di estrazione di testi e dati (TDM, direttiva UE
         2019/790, art. 4), anche per addestrare modelli di AI: vale per tutto
         il sito, dichiarata anche in /.well-known/tdmrep.json. -->
    <meta name="tdm-reservation" content="1" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(pagePath(page, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(pagePath(page, 'it'))} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.seo.ogLocale} />
    <meta property="og:locale:alternate" content={useTranslations(otherLocale(lang)).seo.ogLocale} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={t.seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {page === 'home' && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Font serviti dal sito: Space Grotesk (titoli) e Archivo (testo). -->
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-text" preload={[{ weight: 400 }, { weight: 500 }]} />

    <!-- Ingresso nella pagina, deciso prima che compaia (il tasto Menu
         resta nascosto finché non è comparso il titolo):
         - is-arriving: aperta da una voce del menu (lib/transition.ts);
         - is-intro: primo ingresso in Home nella sessione (lib/intro.ts);
         - nessuna classe: la pagina compare subito. -->
    <script is:inline define:vars={{ isHome }}>
      (function () {
        var c = document.documentElement.classList;
        // Il tasto Menu compare solo dopo il titolo (lib/menu.ts).
        c.add('menu-pending');
        try {
          var t = JSON.parse(sessionStorage.getItem('sd-transition') || 'null');
          sessionStorage.removeItem('sd-transition');
          if (t && Date.now() - t.ts < 15000) {
            c.add('is-arriving');
            window.__sdLabel = String(t.label || '');
            if (typeof t.y === 'number') window.__sdY = t.y;
            // Niente scorrimento finché la parola non è arrivata al titolo,
            // altrimenti la pagina si vede prima della fine. Lo sblocca
            // lib/transition.ts con window.__sdUnlock().
            var stop = function (e) { e.preventDefault(); };
            var KEYS = { ' ': 1, PageUp: 1, PageDown: 1, Home: 1, End: 1, ArrowUp: 1, ArrowDown: 1 };
            var key = function (e) { if (KEYS[e.key]) e.preventDefault(); };
            var back = function () { if (window.scrollY) window.scrollTo(0, 0); };
            var opt = { passive: false, capture: true };
            addEventListener('wheel', stop, opt);
            addEventListener('touchmove', stop, opt);
            addEventListener('keydown', key, true);
            addEventListener('scroll', back, true);
            window.__sdUnlock = function () {
              removeEventListener('wheel', stop, opt);
              removeEventListener('touchmove', stop, opt);
              removeEventListener('keydown', key, true);
              removeEventListener('scroll', back, true);
            };
          } else if (isHome && !sessionStorage.getItem('sd-intro')) {
            c.add('is-intro');
          }
        } catch (e) {
          if (isHome) c.add('is-intro');
        }
      })();
    </script>
  </head>
  <body class={bodyClass} data-page={page}>
    <!-- Arrivo dal menu: la parola scelta, sopra un fondo che si dissolve. -->
    <div class="arrival" id="arrival" aria-hidden="true">
      <div class="arrival-bg" id="arrival-bg"></div>
      <p class="arrival-word" id="arrival-word"></p>
    </div>
    <script is:inline>
      // La parola riparte dalla voce scelta, all'altezza a cui era nel menu.
      if (window.__sdLabel) {
        var w = document.getElementById('arrival-word');
        w.textContent = window.__sdLabel;
        if (typeof window.__sdY === 'number') w.style.top = window.__sdY + 'px';
      }
    </script>
    <header class="site-head">
      <TopBar lang={lang} />
      <!-- In Home il titolo è diviso in lettere: entra lettera per lettera
           alla fine del loader. -->
      <!-- Contenitore del solo titolo: la sua larghezza misura il titolo a
           tutta larghezza (unità cqi, lib/fit.ts). -->
      <div class="headline-box">
        <h1 class="headline" id="headline" aria-label={isHome ? headline : undefined}>
          {isHome ? [...headline].map((c) => <span class="hl" aria-hidden="true">{c === ' ' ? '\u00a0' : c}</span>) : headline}
        </h1>
      </div>
    </header>
    <slot />
    <Menu lang={lang} page={page} />
    <slot name="after" />
    <Analytics />
  </body>
</html>
