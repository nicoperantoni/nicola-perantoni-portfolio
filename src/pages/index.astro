---
import BaseLayout from '../layouts/BaseLayout.astro';
import Veil from '../components/Veil.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Lightbox from '../components/Lightbox.astro';
import Studio from '../components/Studio.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import { buildFlow } from '../data/content';

// Parametri del modulo mappa topografica (README → "Topo Map Module — API").
const TOPO_ACCENT = '#c8b892';
const TOPO_MARKERS = 10;
const TOPO_SHOW_ELEVATION = true;

const flow = buildFlow();
---

<BaseLayout>
  <Veil />
  <div class="page">
    <Hero accent={TOPO_ACCENT} markers={TOPO_MARKERS} showElevation={TOPO_SHOW_ELEVATION} />
    <Work flow={flow} />
    <Studio />
    <Contacts />
    <Footer />
  </div>
  <Lightbox />
</BaseLayout>

<script>
  import { initReveal } from '../lib/reveal';
  initReveal(document);
</script>

<style is:global>
  .page {
    position: relative;
    min-height: 100dvh;
    background: var(--color-bg);
    color: var(--color-text);
  }
</style>
