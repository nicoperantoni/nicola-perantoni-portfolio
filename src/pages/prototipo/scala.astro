---
// PROTOTIPO (non collegato al sito, non indicizzato, fuori dalla sitemap).
//
// Loader, adattato da "Willem Loading Animation" di Osmo
// (https://codepen.io/osmosupply/pen/wBGYEMd), licenza MIT,
// Copyright (c) 2026 Osmo: le lettere di "Studio" e "Devastante" salgono una
// per una, tra le due parole si apre un rettangolo e la foto si allarga dal
// centro; durante il caricamento le foto cambiano di colpo; a caricamento
// finito il rettangolo si allarga e spinge fuori le parole, la foto diventa
// la foto centrale della scala e il titolo entra dall'alto lettera per
// lettera; poi compaiono le altre foto.
//
// Scala: foto allineate in basso che crescono da sinistra a destra. Con
// rotella, trascinamento, frecce della tastiera o pulsanti ogni foto scivola
// verso destra crescendo: al centro della pagina ha la grandezza delle foto
// della Home, poi esce a destra, enorme. All'infinito. Col mouse sopra una
// foto, solo quella resta a colori.
import { Picture, Font } from 'astro:assets';
import { HOME_PHOTOS, photo } from '../../data/photos';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('it');
const [word1, word2] = t.site.name.split(' ');
const letters = (w: string) => [...w];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Prototipo · Scala — Studio Devastante</title>
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-text" />
    <style is:global>
      :root { --bg: #f4f4f4; --ink: #111112; --mute: #8a8a8a; --pad: 14px; --pad-v: clamp(16px, 2.6vh, 32px); }
      html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); overflow: hidden; }
      body { font-family: var(--font-text); -webkit-font-smoothing: antialiased; }
      /* Testata come nel sito principale: riga in alto (lì c'è il tasto
         Menu) e titolo a tutta larghezza, misurato sulla parola. */
      .site-head { position: fixed; inset: 0 0 auto; z-index: 2; padding: var(--pad) var(--pad) var(--pad-v); container-type: inline-size; pointer-events: none; }
      .topbar { display: flex; align-items: center; height: 26px; margin-bottom: 8px; }
      .headline { margin: 0; white-space: nowrap; font-family: var(--font-display); font-weight: 600; font-size: 10.9cqi; line-height: 0.98; font-variant-ligatures: common-ligatures; font-feature-settings: "salt" 1; }

      /* Il palco: le foto sono disegnate alla grandezza più grande che
         raggiungono (così restano nitide) e ridimensionate con scale(),
         con l'origine in basso a sinistra. */
      .stage { position: fixed; inset: 0; z-index: 3; overflow: hidden; touch-action: none; cursor: grab; user-select: none; -webkit-user-select: none; }
      .stage.dragging { cursor: grabbing; }
      .item { position: absolute; left: 0; top: 0; margin: 0; overflow: hidden; transform-origin: 0 100%; will-change: transform; cursor: pointer; }
      .item img { position: absolute; inset: 0 -12%; width: 124%; height: 100%; object-fit: cover; pointer-events: none; -webkit-user-drag: none; }
      .item img { will-change: transform; transition: filter 0.45s ease; }
      .item picture { display: contents; }
      /* Col mouse sopra una foto: solo quella resta a colori. */
      @media (hover: hover) and (pointer: fine) {
        .stage:has(.item:hover) .item:not(:hover) img { filter: grayscale(1); }
      }

      /* Pulsanti freccia: due cerchi scuri affiancati, in basso al centro. */
      .arrows { position: fixed; left: 50%; bottom: calc(var(--pad-v) + 14px); z-index: 5; display: flex; gap: 6px; transform: translateX(-50%); }
      .arrow { display: grid; place-items: center; width: 42px; height: 42px; padding: 0; border: 0; border-radius: 50%; background: rgba(17, 17, 18, 0.55); color: #fff; cursor: pointer; -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); transition: transform 0.25s ease, background-color 0.25s ease; }
      .arrow:hover { transform: scale(1.08); background: rgba(17, 17, 18, 0.75); }
      .arrow:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
      .arrow svg { width: 16px; height: 16px; }

      /* --- Loader (da Osmo, vedi in cima) -------------------------- */
      .intro { position: fixed; inset: 0; z-index: 10; display: flex; justify-content: center; align-items: center; overflow: hidden; pointer-events: none; }
      .w-h1 { display: flex; justify-content: center; white-space: nowrap; font-family: var(--font-display); font-weight: 600; font-size: min(7.6vw, 150px); line-height: 0.82; font-variant-ligatures: common-ligatures; font-feature-settings: "salt" 1; }
      /* Le parole tagliano le lettere che salgono; il padding (compensato)
         lascia spazio alle lettere più alte della riga. */
      .w-start, .w-end { display: flex; overflow: hidden; padding-block: 0.1em; margin-block: -0.1em; }
      .w-start { justify-content: flex-end; }
      .wl { display: block; position: relative; }
      /* Il rettangolo: chiuso lascia lo spazio di una battuta, aperto è
         largo 1em; la foto si allarga dal centro. */
      .w-box { position: relative; display: flex; justify-content: center; align-items: center; width: 0; margin-inline: 0.13em; }
      .w-box-inner { position: relative; display: flex; justify-content: center; align-items: center; min-width: 1em; height: 0.95em; }
      .w-grow { position: absolute; display: flex; justify-content: center; align-items: center; width: 0%; height: 100%; overflow: hidden; }
      .w-wrap { position: absolute; width: 1em; height: 100%; }
      /* Stesso ritaglio delle foto della scala (più larghe del 24%, centrate):
         passando alla foto centrale non c'è nessuno scatto. */
      .w-wrap img { position: absolute; inset: 0 -12%; width: 124%; height: 100%; object-fit: cover; pointer-events: none; }
      .fly { position: fixed; z-index: 11; overflow: hidden; pointer-events: none; }
      /* Titolo: le lettere entrano dall'alto dentro la riga (padding
         compensato, come sopra). */
      .headline { overflow: hidden; padding-block: 0.06em; margin-block: -0.06em; }
      .hl { display: inline-block; white-space: pre; }
      /* Durante il loader: titolo e pulsanti nascosti. */
      .is-intro .headline { visibility: hidden; }
      .is-intro .arrows { opacity: 0; pointer-events: none; }
    </style>
  </head>
  <body class="is-intro">
    <header class="site-head" id="head">
      <!-- Riga vuota al posto del tasto Menu: tiene titolo e foto alle
           stesse altezze della Home. -->
      <div class="topbar" aria-hidden="true"></div>
      <h1 class="headline" id="headline" aria-label={t.site.name}>{
        [...t.site.name].map((c) => <span class="hl" aria-hidden="true">{c === ' ' ? '\u00a0' : c}</span>)
      }</h1>
    </header>

    <div class="stage" id="stage">
      {
        HOME_PHOTOS.map((name) => (
          <figure class="item">
            <Picture
              src={photo(name)}
              alt=""
              widths={[540, 720, 960, 1280, 1600]}
              sizes="(max-width: 700px) 120vw, 70vw"
              formats={['avif']}
              fallbackFormat="webp"
              loading="eager"
              decoding="async"
              draggable="false"
            />
          </figure>
        ))
      }
    </div>

    <nav class="arrows" id="arrows" aria-label="Scorri le foto">
      <button class="arrow" id="prev" type="button" aria-label="Indietro">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
      </button>
      <button class="arrow" id="next" type="button" aria-label="Avanti">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
      </button>
    </nav>

    <div class="intro" id="intro" aria-hidden="true">
      <div class="w-h1">
        <div class="w-start" id="w1">{letters(word1).map((c) => <span class="wl">{c}</span>)}</div>
        <div class="w-box" id="box">
          <div class="w-box-inner">
            <div class="w-grow" id="grow"><div class="w-wrap" id="wrap"></div></div>
          </div>
        </div>
        <div class="w-end" id="w2">{letters(word2).map((c) => <span class="wl">{c}</span>)}</div>
      </div>
    </div>

    <script>
      import { gsap } from 'gsap';
      import { Observer } from 'gsap/Observer';
      gsap.registerPlugin(Observer);

      const stage = document.getElementById('stage')!;
      const items = [...stage.querySelectorAll<HTMLElement>('.item')];
      const imgs = items.map((el) => el.querySelector('img')!);
      const n = items.length;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- Geometria della scala -------------------------------------
      // Ogni foto ha una posizione continua u sulla scala (0 = prima foto a
      // sinistra). Altezza: h(u) = HS · R^(u - UC), dove HS è l'altezza
      // delle foto della Home e UC la posizione in cui la foto è centrata
      // nella pagina: lì ha esattamente quella grandezza. Il bordo sinistro
      // è la somma delle larghezze precedenti: con la serie geometrica vale
      // per qualsiasi u reale, quindi il movimento è continuo.
      const ASPECT = 2 / 3; // come le foto della Home
      const R = 1.32; // ogni gradino è il 32% più grande del precedente
      const MAX_U = 2.6; // oltre UC + MAX_U la foto è già fuori dallo schermo
      let W = 0, H = 0, PAD = 14, GAP = 12, HS = 0, UC = 0, PHASE = 0, baseline = 0, hDraw = 0;

      const head = document.getElementById('head')!;
      const headline = document.getElementById('headline')!;
      const padV = () => Math.min(32, Math.max(16, H * 0.026));

      // Titolo a tutta larghezza misurato sulla parola, come nel sito.
      function fitHeadline() {
        headline.style.fontSize = '100px';
        const r = document.createRange();
        r.selectNodeContents(headline);
        headline.style.fontSize = `calc(100cqi / ${(r.getBoundingClientRect().width / 100).toFixed(4)})`;
      }

      // Altezza delle foto nella Home: come nel sito, lo schermo meno la
      // testata (misurata qui, è identica) e il margine in basso.
      function homePhotoHeight() {
        if (W <= 900) return Math.min(H * 0.62, (W - 2 * PAD) / ASPECT * 0.78);
        return H - head.offsetHeight - padV();
      }

      const wAt = (u: number) => ASPECT * HS * Math.pow(R, u - UC);
      const xAt = (u: number) => PAD + (ASPECT * HS * Math.pow(R, -UC) * (Math.pow(R, u) - 1)) / (R - 1) + GAP * u;
      // Posizione della foto i sulla scala, ripetuta all'infinito. La fila
      // parte da -2: lì le foto sono già fuori dallo schermo a sinistra, così
      // il passaggio da un capo all'altro della fila non si vede mai e a
      // sinistra c'è sempre la foto successiva.
      const U0 = -2;
      const uOf = (i: number) => ((((i + current) % n) + n) % n) + U0 + PHASE;

      function measure() {
        W = window.innerWidth;
        H = window.innerHeight;
        GAP = W <= 900 ? 8 : 12;
        fitHeadline();
        HS = homePhotoHeight();
        baseline = H - padV();
        // UC: la posizione in cui il centro della foto cade a metà pagina
        // (ricerca binaria: il centro cresce con u).
        let lo = 0, hi = 12;
        for (let k = 0; k < 40; k++) {
          UC = (lo + hi) / 2;
          const c = xAt(UC) + wAt(UC) / 2;
          if (c < W / 2) lo = UC; else hi = UC;
        }
        UC = (lo + hi) / 2;
        // Gradini di riposo spostati così che, da fermo, una foto sia
        // esattamente al centro con la grandezza della Home.
        PHASE = UC - Math.floor(UC);
        // Grandezza a cui disegnare le foto: la più grande visibile.
        hDraw = HS * Math.pow(R, MAX_U);
        items.forEach((el) => {
          el.style.width = `${ASPECT * hDraw}px`;
          el.style.height = `${hDraw}px`;
        });
      }

      // --- Movimento --------------------------------------------------
      // target: dove vuole arrivare chi scorre; current lo insegue con
      // inerzia. Fermandosi, target si aggancia al gradino intero più vicino.
      let target = 0, current = 0, snapTimer = 0, ready = false;
      const snap = () => { target = Math.round(target); };
      const nudge = (d: number) => {
        if (!ready) return;
        target += d;
        clearTimeout(snapTimer);
        snapTimer = window.setTimeout(snap, 140);
      };
      const step = (d: number) => { if (ready) target = Math.round(target) + d; };

      function render() {
        for (let i = 0; i < n; i++) {
          const u = uOf(i);
          const el = items[i];
          const x = xAt(u);
          // Oltre il bordo destro (o prima dell'ingresso a sinistra) è nascosta.
          if (x + wAt(u) < 0 || x > W) { el.style.visibility = 'hidden'; continue; }
          el.style.visibility = '';
          const s = (HS * Math.pow(R, u - UC)) / hDraw;
          el.style.transform = `translate3d(${x.toFixed(2)}px, ${(baseline - hDraw).toFixed(2)}px, 0) scale(${s.toFixed(4)})`;
          // Leggera parallasse dentro la foto, legata alla posizione.
          imgs[i].style.transform = `translate3d(${((u - UC) * -2.2).toFixed(2)}%, 0, 0)`;
        }
      }

      gsap.ticker.add(() => {
        const d = target - current;
        if (Math.abs(d) < 0.0005) { if (current !== target) { current = target; render(); } return; }
        current += d * (reduced ? 1 : 0.09);
        render();
      });

      // Rotella, trascinamento e tocco in un solo gesto (GSAP Observer).
      Observer.create({
        target: stage,
        type: 'wheel,touch,pointer',
        onChangeX: (self) => nudge(self.deltaX * (self.event.type === 'wheel' ? 0.0035 : 0.006)),
        onChangeY: (self) => { if (self.event.type === 'wheel') nudge(self.deltaY * 0.0035); },
        onPress: () => stage.classList.add('dragging'),
        onRelease: (self) => {
          stage.classList.remove('dragging');
          // Lancio: la velocità al rilascio prosegue un po'.
          nudge(gsap.utils.clamp(-2, 2, self.velocityX * 0.0008));
        },
        tolerance: 2,
        preventDefault: true,
      });

      // Frecce (tastiera e pulsanti): un gradino alla volta.
      document.addEventListener('keydown', (ev) => {
        if (ev.key === 'ArrowRight') { step(1); ev.preventDefault(); }
        if (ev.key === 'ArrowLeft') { step(-1); ev.preventDefault(); }
      });
      document.getElementById('next')!.addEventListener('click', () => step(1));
      document.getElementById('prev')!.addEventListener('click', () => step(-1));

      // Click su una foto: la scala scorre finché quella foto è al centro della
      // pagina. Un trascinamento non conta come click.
      let downX = 0, downY = 0;
      stage.addEventListener('pointerdown', (ev) => { downX = ev.clientX; downY = ev.clientY; });
      items.forEach((el, i) => el.addEventListener('click', (ev) => {
        if (!ready || Math.hypot(ev.clientX - downX, ev.clientY - downY) > 6) return;
        target = Math.round(target + (UC - uOf(i)));
      }));

      window.addEventListener('resize', () => { measure(); render(); });

      // --- Loader (tempi e curve da Osmo, vedi in cima) ------------
      const intro = document.getElementById('intro')!;
      const box = document.getElementById('box')!;
      const grow = document.getElementById('grow')!;
      const wrap = document.getElementById('wrap')!;
      const w1 = document.getElementById('w1')!;
      const w2 = document.getElementById('w2')!;
      const fam = (el: Element) => getComputedStyle(el).fontFamily;
      const fonts = Promise.all([
        document.fonts.load(`600 100px ${fam(headline)}`),
        document.fonts.load(`600 100px ${fam(w1)}`),
      ]).catch(() => null).then(() => document.fonts.ready);
      const loaded = (img: HTMLImageElement) =>
        img.complete ? Promise.resolve() : new Promise<void>((r) => { img.onload = img.onerror = () => r(); });
      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

      measure();
      render();
      fonts.then(() => { measure(); render(); });

      // Foto che sarà al centro della scala: è quella su cui si ferma il
      // rettangolo e che poi diventa la foto centrale.
      const centerIdx = () => items.findIndex((_, i) => Math.abs(uOf(i) - UC) < 0.01);
      const done = () => { intro.remove(); document.body.classList.remove('is-intro'); ready = true; };

      async function runIntro() {
        await fonts;
        if (reduced) { done(); return; }
        // Tutte le foto della scala partono nascoste (si scoprono alla fine).
        gsap.set(imgs, { clipPath: 'inset(100% 0% 0% 0%)' });

        // Foto del rettangolo: in cima quelle che cambiano durante il
        // caricamento, sotto quella centrale (resta l'ultima).
        const ci = centerIdx();
        const pick = [...items.keys()].filter((i) => i !== ci).slice(0, 4);
        const mk = (i: number, z: number) => {
          const im = document.createElement('img');
          im.alt = '';
          im.src = imgs[i].currentSrc || imgs[i].src;
          im.style.zIndex = String(z);
          wrap.appendChild(im);
          return im;
        };
        const extras = pick.map((i, k) => mk(i, pick.length - k + 1));
        const cover = mk(ci, 1);

        // 1. Le lettere salgono una per una. 2. Il rettangolo si apre a 1em e
        // la foto si allarga dal centro; le parole si scostano appena.
        const tl = gsap.timeline({ defaults: { ease: 'expo.inOut' } })
          .from('.wl', { yPercent: 100, stagger: 0.025, duration: 1.25 })
          .fromTo(box, { width: '0em' }, { width: '1em', duration: 1.25 }, '<1.25')
          .fromTo(grow, { width: '0%' }, { width: '100%', duration: 1.25 }, '<')
          .fromTo(w1, { x: '0em' }, { x: '-0.05em', duration: 1.25 }, '<')
          .fromTo(w2, { x: '0em' }, { x: '0.05em', duration: 1.25 }, '<');

        // Caricamento reale: font, foto del rettangolo, la centrale e quelle
        // visibili nella scala.
        const visible = items.map((_, i) => i).filter((i) => { const u = uOf(i); return xAt(u) + wAt(u) > 0 && xAt(u) <= W; });
        let isLoaded = false;
        Promise.all([...extras, cover].map(loaded).concat(visible.map((i) => loaded(imgs[i])))).then(() => { isLoaded = true; });

        // 3. A rettangolo aperto le foto cambiano di colpo ogni mezzo secondo
        // (quella sopra sparisce); se il caricamento non è finito, il giro
        // ricomincia. Alla fine resta la foto centrale.
        await tl.then();
        for (;;) {
          for (const im of extras) { await wait(500); gsap.to(im, { opacity: 0, duration: 0.05, ease: 'none' }); }
          if (isLoaded) break;
          await wait(500);
          gsap.set(extras, { opacity: 1 });
        }
        await wait(450);

        // 4. Il rettangolo si allarga oltre lo schermo e spinge fuori le parole;
        // la foto (in un livello a sé) diventa la foto centrale della scala.
        // 5. Il titolo entra dall'alto lettera per lettera.
        const from = grow.getBoundingClientRect();
        const fly = document.createElement('div');
        fly.className = 'fly';
        const fimg = cover.cloneNode() as HTMLImageElement;
        // Stesso ritaglio della foto della scala (più larga del 24%, centrata).
        Object.assign(fimg.style, { position: 'absolute', inset: '0 -12%', width: '124%', height: '100%', objectFit: 'cover' });
        fly.appendChild(fimg);
        Object.assign(fly.style, { left: `${from.left}px`, top: `${from.top}px`, width: `${from.width}px`, height: `${from.height}px` });
        document.body.appendChild(fly);
        grow.style.visibility = 'hidden';
        const to = { left: xAt(UC), top: baseline - HS, width: ASPECT * HS, height: HS };
        const others = items.map((_, i) => i).filter((i) => i !== ci)
          .sort((a, b) => Math.abs(uOf(a) - UC) - Math.abs(uOf(b) - UC));
        // Larghezza a cui il rettangolo spinge fuori dallo schermo entrambe
        // le parole. Il rettangolo non è al centro esatto ("Studio" è più
        // corta di "Devastante"): conta il lato più lontano dal bordo.
        const bx = box.getBoundingClientRect();
        const c = bx.left + bx.width / 2;
        const margin = parseFloat(getComputedStyle(box).marginLeft) || 0;
        const pushOut = 2 * (Math.max(c, W - c) + margin) + 40;

        gsap.timeline({ defaults: { ease: 'expo.inOut' }, onComplete: () => { fly.remove(); done(); } })
          .to(box, { width: pushOut, duration: 1.6 }, 0)
          .to(fly, { ...to, duration: 1.6 }, 0)
          .add(() => { headline.style.visibility = 'visible'; }, 1.0)
          .from('.hl', { yPercent: -100, duration: 1.25, ease: 'expo.out', stagger: 0.025 }, 1.0)
          // La foto centrale prende il posto del livello volante.
          .add(() => { gsap.set(imgs[ci], { clipPath: 'inset(0% 0% 0% 0%)' }); fly.style.visibility = 'hidden'; }, 1.6)
          // 6. Le altre foto si scoprono dal basso, dal centro verso i lati.
          .to(others.map((i) => imgs[i]), { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.9, ease: 'expo.out', stagger: 0.07 }, 1.5)
          .add(() => { document.body.classList.remove('is-intro'); }, 1.5)
          .fromTo('#arrows', { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power2.out' }, 1.9);
      }

      runIntro();
    </script>
  </body>
</html>
