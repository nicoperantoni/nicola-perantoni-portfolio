---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contatti" class="contacts">
  <h2 class="contacts__title">
    {
      lang === 'it' ? (
        <Fragment>
          Racconto <em>storie</em> di brand, gare, <em>squadre <span class="contacts__and">e</span> atleti.</em>
        </Fragment>
      ) : (
        <Fragment>
          I tell <em>stories</em> of brands, races, <em>teams <span class="contacts__and">and</span> athletes.</em>
        </Fragment>
      )
    }
  </h2>

  <div class="contacts__row">
    <div class="contacts__block">
      <span class="contacts__label">{t.contacts.emailLabel}</span>
      <a href="#" id="contact-email" class="contacts__value" rel="nofollow"></a>
    </div>
    <div class="contacts__block">
      <span class="contacts__label">{t.contacts.whatsappLabel}</span>
      <a href="#" id="contact-whatsapp" class="contacts__value" target="_blank" rel="noopener noreferrer nofollow"></a>
    </div>
    <div class="contacts__block">
      <span class="contacts__label">{t.contacts.instagramLabel}</span>
      <a href="https://instagram.com/nicolaperantoni" target="_blank" rel="noopener noreferrer" class="contacts__value"
        >@nicolaperantoni ↗</a
      >
    </div>
    <div class="contacts__block">
      <span class="contacts__label">{t.contacts.locationLabel}</span>
      <span class="contacts__value contacts__value--static">{t.contacts.locationValue}</span>
    </div>
  </div>
</section>

<style>
  .contacts {
    position: relative;
    z-index: 2;
    min-height: 30dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(24px, 4vh, 48px);
    padding: clamp(32px, 5.5vh, 66px) var(--space-section-x) clamp(60px, 9vh, 110px);
  }

  .contacts__title {
    margin: 0 auto;
    max-width: 20ch;
    text-align: center;
    font-weight: 300;
    font-size: clamp(2.2rem, 6vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .contacts__title em {
    font-family: var(--font-serif-italic);
    font-style: italic;
    font-weight: 400;
    font-size: 1em;
  }

  .contacts__and {
    font-family: var(--font-archivo);
    font-style: normal;
    font-weight: 300;
  }

  .contacts__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(20px, 3vw, 56px) clamp(32px, 6vw, 96px);
    margin-top: clamp(24px, 5vh, 64px);
    align-items: start;
    text-align: center;
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.2vw, 14px);
    letter-spacing: 0.06em;
  }

  .contacts__block {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contacts__label {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .contacts__value {
    color: rgba(16, 17, 20, 0.92);
  }

  a.contacts__value:hover {
    color: #000000;
  }
</style>

<script>
  // Indirizzo e numero scritti al contrario, ricomposti solo lato client:
  // gli scraper che leggono l'HTML statico non trovano le stringhe
  // (stesso pattern di TopBar.astro).
  const user = 'inotnarep.alocin'.split('').reverse().join('');
  const domain = 'moc.liamg'.split('').reverse().join('');
  const email = `${user}@${domain}`;

  const emailLink = document.getElementById('contact-email') as HTMLAnchorElement | null;
  if (emailLink) {
    emailLink.href = `mailto:${email}`;
    emailLink.textContent = email;
    emailLink.removeAttribute('rel');
  }

  const phone = '4562717643 93'.replace(/\s/g, '').split('').reverse().join('');
  const whatsappLink = document.getElementById('contact-whatsapp') as HTMLAnchorElement | null;
  if (whatsappLink) {
    whatsappLink.href = `https://wa.me/${phone}`;
    whatsappLink.textContent = `+${phone.slice(0, 2)} ${phone.slice(2, 5)} ${phone.slice(5, 8)} ${phone.slice(8)} ↗`;
  }
</script>
