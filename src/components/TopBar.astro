---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pdfHref = lang === 'en' ? '/portfolio-en.pdf' : '/portfolio-it.pdf';
---

<div class="topbar">
  <div class="topbar__side">
    <a href="#" id="topbar-email" class="topbar__icon-btn" aria-label={t.topbar.emailAria} rel="nofollow">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="3" />
        <path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <a
      href="#"
      id="topbar-whatsapp"
      class="topbar__icon-btn"
      target="_blank"
      rel="noopener noreferrer nofollow"
      aria-label={t.topbar.whatsappAria}
    >
      <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
        <path
          d="M12.05 2C6.53 2 2.05 6.48 2.05 12c0 1.9.53 3.68 1.44 5.2L2 22l4.94-1.46A9.94 9.94 0 0 0 12.05 22c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm0 18.2c-1.65 0-3.2-.46-4.53-1.26l-.32-.19-3 .88.9-2.93-.21-.33a8.2 8.2 0 0 1-1.26-4.37c0-4.55 3.7-8.25 8.25-8.25 4.55 0 8.25 3.7 8.25 8.25-.01 4.55-3.71 8.2-8.28 8.2Z"
        />
        <path
          d="M16.55 14.25c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.13-.16.25-.63.8-.78.96-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.22.25-.87.85-.87 2.07 0 1.22.89 2.4 1.02 2.57.12.16 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.66-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.47-.28Z"
        />
      </svg>
    </a>
  </div>
  <a href={pdfHref} class="topbar__link" download>{t.topbar.pdfLink}</a>
  <div class="topbar__side topbar__side--end">
    <a
      href="https://instagram.com/nicolaperantoni"
      target="_blank"
      rel="noopener noreferrer"
      class="topbar__icon-btn"
      aria-label={t.topbar.instagramAria}
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4.2" />
        <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
      </svg>
    </a>
    <LangSwitch lang={lang} />
  </div>
</div>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 150;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: clamp(12px, 2vh, 18px) clamp(14px, 3vw, 28px);
    background: var(--color-bg);
    font-family: var(--font-mono);
  }

  .topbar__side {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .topbar__side--end {
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
  }

  .topbar__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid rgba(16, 17, 20, 0.55);
    background: rgba(16, 17, 20, 0.06);
    color: rgba(16, 17, 20, 0.92);
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .topbar__icon-btn:hover {
    background: rgba(16, 17, 20, 0.14);
    border-color: rgba(16, 17, 20, 0.5);
  }

  .topbar__link {
    justify-self: center;
    font-size: clamp(11px, 1.2vw, 13px);
    letter-spacing: 0.05em;
    color: rgba(16, 17, 20, 0.92);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .topbar__link:hover {
    color: #000000;
    text-decoration: underline;
  }
</style>

<script>
  // Indirizzo e numero scritti al contrario, ricomposti solo lato client:
  // gli scraper che leggono l'HTML statico non trovano le stringhe
  // (stesso pattern di Contacts.astro).
  const user = 'inotnarep.alocin'.split('').reverse().join('');
  const domain = 'moc.liamg'.split('').reverse().join('');
  const email = `${user}@${domain}`;

  const emailLink = document.getElementById('topbar-email') as HTMLAnchorElement | null;
  if (emailLink) {
    emailLink.href = `mailto:${email}`;
    emailLink.removeAttribute('rel');
  }

  // wa.me vuole solo cifre (senza "+").
  const phone = '4562717643 93'.replace(/\s/g, '').split('').reverse().join('');
  const whatsappLink = document.getElementById('topbar-whatsapp') as HTMLAnchorElement | null;
  if (whatsappLink) {
    whatsappLink.href = `https://wa.me/${phone}`;
  }
</script>
