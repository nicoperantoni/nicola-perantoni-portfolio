---
// Riga sopra al titolo: tasto Menu a sinistra (resta sopra al menu aperto e
// diventa "Chiudi"). Niente selettore di lingua: la lingua la sceglie il
// browser del visitatore (middleware.ts).
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="topbar">
  <button
    class="menu-btn"
    id="menu-btn"
    type="button"
    aria-expanded="false"
    aria-controls="menu"
    data-open={t.menu.open}
    data-close={t.menu.close}
  >
    <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
    <span class="menu-label" id="menu-label">{t.menu.open}</span>
  </button>
</div>
