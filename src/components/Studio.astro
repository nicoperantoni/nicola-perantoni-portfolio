---
import { services } from '../data/content';
---

<section id="studio" class="studio">
  <div class="studio__intro" data-reveal="up">
    <h2 class="studio__title">Sono un fotografo <em>sportivo</em>, ma anche un atleta.</h2>
    <div class="studio__copy">
      <p>Conosco lo sport perché lo vivo in prima persona ed è questo che mi permette di lavorare a stretto contatto con atleti e brand.</p>
      <p>Lavoro da Verona su tutta Italia e all'estero, con squadre, federazioni e brand tecnici — tra gli altri PH Apparel, Cérvelo, Zullo Bike e Ristora.</p>
    </div>
  </div>

  <div class="studio__services" data-reveal="up">
    <span class="studio__services-label">Servizi</span>
    {
      services.map((s) => (
        <div class="studio__service-row" data-reveal="up">
          <span class="studio__service-n">{s.n}</span>
          <h3 class="studio__service-title">{s.title}</h3>
        </div>
      ))
    }
  </div>
</section>

<style>
  .studio {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(30px, 5vh, 64px);
    padding: var(--space-section-y) var(--space-section-x) clamp(40px, 7vh, 90px);
  }

  .studio__intro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(24px, 4vw, 72px);
    align-items: start;
  }

  .studio__title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(1.9rem, 4.2vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .studio__title em {
    font-family: var(--font-serif-italic);
    font-style: italic;
    font-weight: 400;
  }

  .studio__copy {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2vh, 22px);
    max-width: 56ch;
    font-weight: 300;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .studio__copy p {
    margin: 0;
  }

  .studio__services {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.4vh, 16px);
    padding: clamp(20px, 2.2vw, 32px);
    border-radius: var(--radius-md);
    background: var(--color-card);
  }

  .studio__services-label {
    font-family: var(--font-mono);
    font-size: clamp(9px, 1.05vw, 11px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: clamp(6px, 1.2vh, 14px);
  }

  .studio__service-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(10px, 1.2vw, 18px);
    align-items: baseline;
  }

  .studio__service-n {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--color-text-quaternary);
  }

  .studio__service-title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(1.3rem, 2.2vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
</style>
