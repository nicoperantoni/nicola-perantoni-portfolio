---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="studio" class="studio">
  <div class="studio__services" data-reveal="up">
    <span class="studio__services-label">{t.studio.servicesLabel}</span>
    {
      t.studio.services.map((s) => (
        <div class="studio__service-row" data-reveal="up">
          <span class="studio__service-n">{s.n}</span>
          <h3 class="studio__service-title">{s.title}</h3>
        </div>
      ))
    }
  </div>
</section>

<style>
  .studio {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(30px, 5vh, 64px);
    padding: var(--space-section-y) var(--space-section-x) clamp(40px, 7vh, 90px);
  }

  .studio__services {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.4vh, 16px);
    padding: clamp(20px, 2.2vw, 32px);
    border-radius: var(--radius-md);
    background: var(--color-card);
  }

  .studio__services-label {
    font-family: var(--font-mono);
    font-size: clamp(9px, 1.05vw, 11px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: clamp(6px, 1.2vh, 14px);
  }

  .studio__service-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(10px, 1.2vw, 18px);
    align-items: baseline;
  }

  .studio__service-n {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--color-text-quaternary);
  }

  .studio__service-title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(1.3rem, 2.2vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
</style>
