---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="studio" class="studio">
  <div class="studio__services" data-reveal="up">
    <span class="studio__services-label">{t.studio.servicesLabel}</span>
    {
      t.studio.services.map((s) => (
        <div class="studio__service-row" data-reveal="up">
          <span class="studio__service-hover-bar" aria-hidden="true" />
          <span class="studio__service-n">{s.n}</span>
          <h2 class="studio__service-title">{s.title}</h2>
          <p class="studio__service-desc">{s.desc}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .studio {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(30px, 5vh, 64px);
    padding: clamp(36px, 5.5vh, 76px) var(--space-section-x) clamp(40px, 7vh, 90px);
  }

  .studio__services {
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2.2vw, 32px) 0;
  }

  .studio__services-label {
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.4vw, 15px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-top: clamp(6px, 1.4vh, 12px);
    margin-bottom: clamp(20px, 3.4vh, 34px);
  }

  .studio__service-row {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto 1fr minmax(150px, 240px);
    gap: clamp(10px, 1.6vw, 28px);
    align-items: center;
    padding: clamp(14px, 2vh, 22px) clamp(14px, 1.6vw, 24px);
    border-top: 1px solid rgba(16, 17, 20, 0.1);
  }

  .studio__service-row:first-of-type {
    border-top: none;
  }

  /* Barra che si "srotola" dall'alto dietro alla riga, in stile
     runrobrun.com: stesso meccanismo (scaleY ancorato in alto),
     colori del sito invece dei loro. */
  .studio__service-hover-bar {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-text);
    transform-origin: center top;
    transform: scaleY(0);
    transition: transform 0.48s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .studio__service-row:hover .studio__service-hover-bar {
    transform: scaleY(1);
  }

  .studio__service-n,
  .studio__service-title,
  .studio__service-desc {
    position: relative;
    z-index: 1;
    transition: color 0.3s ease;
  }

  .studio__service-row:hover .studio__service-n,
  .studio__service-row:hover .studio__service-title {
    color: var(--color-accent);
  }

  .studio__service-row:hover .studio__service-desc {
    color: var(--color-on-dark-secondary);
  }

  .studio__service-n {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--color-text-tertiary);
  }

  .studio__service-title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(1.3rem, 2.2vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .studio__service-desc {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    .studio__service-row {
      grid-template-columns: auto 1fr;
      row-gap: 6px;
    }

    .studio__service-desc {
      grid-column: 1 / -1;
    }
  }
</style>
