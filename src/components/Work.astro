---
import { Picture } from 'astro:assets';
import type { FlowItem } from '../data/content';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  flow: FlowItem[];
  lang: Locale;
}

const { flow, lang } = Astro.props;
const t = useTranslations(lang);
const pdfHref = lang === 'en' ? '/portfolio-en.pdf' : '/portfolio-it.pdf';

const EAGER_IMAGE_COUNT = 4;
const PHOTO_WIDTHS = [420, 640, 900, 1200];
const PHOTO_SIZES = '(min-width: 1000px) 28vw, (min-width: 620px) 43vw, 88vw';

let imageIndex = -1;
---

<section id="work" class="work">
  <div class="flow" id="flow">
    {
      flow.map((item) => {
        if (item.kind === 'image') {
          imageIndex++;
          const eager = imageIndex < EAGER_IMAGE_COUNT;
          return (
            <div class="shot">
              <Picture
                src={item.image}
                alt={item.alt}
                widths={PHOTO_WIDTHS}
                sizes={PHOTO_SIZES}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                loading={eager ? 'eager' : 'lazy'}
                fetchpriority={eager ? 'high' : 'auto'}
                decoding="async"
                draggable="false"
              />
            </div>
          );
        }
        return (
          <div class="shot">
            <span class="shot__text">{item.body}</span>
          </div>
        );
      })
    }
  </div>

  <div class="work__cta" data-reveal="up">
    <p class="work__cta-title">{t.work.ctaTitle}</p>
    <a href={pdfHref} class="work__cta-button" download>{t.work.ctaButton}</a>
  </div>
</section>

<style>
  .work {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2vh, 24px);
    padding: clamp(12px, 2vh, 20px) 0 clamp(24px, 4vh, 54px);
    margin-top: clamp(24px, 4vh, 56px);
  }

  .flow {
    perspective: 1600px;
    perspective-origin: 50% 40%;
    padding: clamp(6px, 1vh, 12px) var(--space-section-x) clamp(10px, 1.6vh, 20px);
    column-gap: clamp(24px, 3.2vw, 44px);
  }

  .shot {
    position: relative;
    overflow: hidden;
    align-self: start;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: rgba(16, 17, 20, 0.08);
    cursor: pointer;
  }

  .shot :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .shot__text {
    display: block;
    height: 100%;
    padding: clamp(4px, 0.8vw, 12px) clamp(6px, 1.4vw, 22px) 0 0;
    max-width: 26ch;
    font-family: var(--font-archivo);
    font-weight: 300;
    font-size: clamp(1.35rem, 2.3vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: rgba(16, 17, 20, 0.82);
    text-wrap: pretty;
  }

  .work__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(18px, 2.6vh, 30px);
    padding: clamp(24px, 4vh, 48px) var(--space-section-x) 0;
    text-align: center;
  }

  .work__cta-title {
    margin: 0;
    font-family: var(--font-archivo);
    font-weight: 300;
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .work__cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: clamp(14px, 1.8vh, 18px) clamp(28px, 3.4vw, 44px);
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-on-dark);
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.1vw, 13px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .work__cta-button:hover {
    background: #000000;
    transform: translateY(-2px);
  }
</style>

<script>
  import { initFlowLayout } from '../lib/flow-layout';

  const container = document.getElementById('flow');
  if (container) {
    initFlowLayout(container, {
      onPhotoClick: (src, list) => {
        window.dispatchEvent(new CustomEvent('lightbox:open', { detail: { src, list } }));
      },
    });
  }
</script>
