---
// Valore di un recapito. Email e WhatsApp sono vuoti nell'HTML e ricomposti
// lato client (lib/contacts.ts), così non sono leggibili dai raccoglitori
// di indirizzi.
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  kind: 'email' | 'wa' | 'ig' | 'loc' | 'pdf';
  lang: Locale;
}

const { kind, lang } = Astro.props;
const t = useTranslations(lang).contacts;
// Freccia come carattere di testo (U+FE0E): senza, iPhone la mostra come emoji.
const ARROW = '↗\uFE0E';
---

{kind === 'email' && <a class="u" href="#" data-email rel="nofollow" />}
{kind === 'wa' && <a class="u" href="#" data-wa target="_blank" rel="noopener nofollow" />}
{
  kind === 'ig' && (
    <a class="u" href="https://instagram.com/devastante.studio/" target="_blank" rel="noopener">
      @devastante.studio {ARROW}
    </a>
  )
}
{kind === 'loc' && t.locationValue}
{
  kind === 'pdf' && (
    <a class="u" href={t.portfolioPdf} download>
      {t.portfolioLink} ↓
    </a>
  )
}
