---
// Parametri del modulo mappa topografica — vedi README → "Topo Map Module — API".
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  accent?: string;
  markers?: number;
  showElevation?: boolean;
  theme?: 'dark' | 'light';
}

const { lang, accent = '#c8b892', markers = 10, showElevation = true, theme = 'dark' } = Astro.props;
const t = useTranslations(lang);
const { words, then, role, tagline, paragraphs: introParagraphs } = t.hero;
// Stesso hex dei design token --color-text / --color-on-dark (global.css):
// lo script del canvas non legge le CSS custom properties, va duplicato a mano.
const lineColor = theme === 'light' ? '#101114' : '#ffffff';
// L'oro è troppo poco leggibile per le etichette (GPS/attività) su sfondo
// chiaro: lì il testo passa allo stesso scuro delle curve di livello.
const labelColor = theme === 'light' ? '#101114' : accent;
---

<section class="hero" data-theme={theme}>
  <div class="hero__panel">
    <div class="hero__map" aria-hidden="true">
      <canvas id="topo-static" class="hero__canvas"></canvas>
      <canvas id="topo-marks" class="hero__canvas hero__canvas--marks"></canvas>
    </div>

    <div class="hero__content">
      <h1 class="hero__headline">
        <strong class="hero__word-wrap"
          ><span class="hero__word-window"><span id="hero-word" class="hero__word">{words[0]}</span></span></strong
        ><br />
        <em class="hero__serif">{then}</em><br />
        <strong class="hero__bold">{role}</strong>
      </h1>

      <p class="hero__tagline">{tagline}</p>

      <div class="hero__intro">
        {introParagraphs.map((p) => <span>{p}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 94dvh;
    display: flex;
    align-items: stretch;
    --hero-bg: #000000;
    --hero-text: var(--color-on-dark);
    --hero-text-secondary: var(--color-on-dark-secondary);
    --hero-text-tertiary: var(--color-on-dark-tertiary);
  }

  .hero[data-theme='light'] {
    /* Volutamente diverso dal grigio (--color-bg) del resto del sito: come
       nella versione dark, l'hero resta una sezione visivamente a sé —
       qui un bianco caldo che richiama l'oro dell'accent. */
    --hero-bg: #f4f1ec;
    --hero-text: var(--color-text);
    --hero-text-secondary: var(--color-text-secondary);
    --hero-text-tertiary: var(--color-text-tertiary);
  }

  .hero__panel {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: clamp(22px, 4vh, 56px);
    padding: clamp(20px, 3vw, 44px);
    text-align: center;
    background: var(--hero-bg);
    overflow: hidden;
  }

  .hero__map {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: min(78%, 1000px);
    z-index: 0;
    display: block;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 48%,
      rgba(0, 0, 0, 0.88) 62%,
      rgba(0, 0, 0, 0.62) 74%,
      rgba(0, 0, 0, 0.34) 84%,
      rgba(0, 0, 0, 0.14) 92%,
      transparent 98%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 48%,
      rgba(0, 0, 0, 0.88) 62%,
      rgba(0, 0, 0, 0.62) 74%,
      rgba(0, 0, 0, 0.34) 84%,
      rgba(0, 0, 0, 0.14) 92%,
      transparent 98%
    );
  }

  /* Su schermi stretti il testo introduttivo cade più in basso nella mappa
     (colonna singola, meno spazio orizzontale): la dissolvenza standard
     lascia ancora troppa mappa visibile lì. Qui sfuma molto prima, così
     dietro al testo c'è quasi solo nero pieno. */
  @media (max-width: 640px) {
    .hero__map {
      mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 34%,
        rgba(0, 0, 0, 0.7) 48%,
        rgba(0, 0, 0, 0.35) 58%,
        rgba(0, 0, 0, 0.12) 68%,
        transparent 78%
      );
      -webkit-mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 34%,
        rgba(0, 0, 0, 0.7) 48%,
        rgba(0, 0, 0, 0.35) 58%,
        rgba(0, 0, 0, 0.12) 68%,
        transparent 78%
      );
    }

    /* Lo spazio sopra al testo introduttivo era tarato per compensare la
       mappa ancora visibile lì — ora che la dissolvenza (sopra) fa già
       il lavoro, può stare più vicino al titolo senza perdere leggibilità. */
    .hero__intro {
      padding-top: clamp(24px, 5vh, 60px);
    }
  }

  .hero__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__canvas--marks {
    position: absolute;
    inset: 0;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 4vh, 40px);
    flex: 0 0 auto;
    min-height: 66dvh;
    padding-top: clamp(120px, 22vh, 300px);
    padding-bottom: clamp(28px, 5vh, 80px);
    width: 100%;
    animation: riseIn 1.1s cubic-bezier(0.22, 0.7, 0.2, 1) both;
  }

  .hero__headline {
    margin: 0;
    font-family: var(--font-archivo);
    font-weight: 300;
    font-size: clamp(3.2rem, 11vw, 7rem);
    line-height: 1.14;
    letter-spacing: -0.035em;
    color: var(--hero-text);
  }

  .hero__word-wrap {
    font-weight: 600;
  }

  .hero__word-window {
    position: relative;
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    height: 1.14em;
    min-width: 7.4ch;
    text-align: center;
  }

  .hero__word {
    display: inline-block;
    will-change: transform, opacity;
  }

  .hero__serif {
    font-family: var(--font-serif-italic);
    font-style: italic;
    font-weight: 400;
  }

  .hero__bold {
    font-weight: 600;
  }

  .hero__tagline {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: clamp(10px, 1vw, 12px);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--hero-text-tertiary);
  }

  .hero__intro {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2.4vh, 26px);
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
    padding-top: clamp(32px, 6vh, 80px);
    padding-bottom: clamp(14px, 2.5vh, 40px);
    font-family: var(--font-archivo);
    font-weight: 300;
    font-size: clamp(1.05rem, 1.6vw, 1.6rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--hero-text-secondary);
    text-wrap: pretty;
  }
</style>

<script is:inline define:vars={{ accent, markers, showElevation, lineColor, labelColor, words }}>
  // define:vars è inline-only (niente import bundlati, niente TypeScript):
  // passa solo i dati al modulo processato da Vite nel secondo <script>.
  window.__heroConfig = { accent, markers, showElevation, lineColor, labelColor, words };
</script>

<script>
  import { createTopoMap } from '../lib/topo-map';
  import { startWordCycle } from '../lib/word-cycle';

  const { accent, markers, showElevation, lineColor, labelColor, words } = (window as any).__heroConfig as {
    accent: string;
    markers: number;
    showElevation: boolean;
    labelColor: string;
    lineColor: string;
    words: string[];
  };

  const staticCanvas = document.getElementById('topo-static') as HTMLCanvasElement | null;
  const marksCanvas = document.getElementById('topo-marks') as HTMLCanvasElement | null;
  if (staticCanvas && marksCanvas) {
    createTopoMap(staticCanvas, marksCanvas, { accent, markers, showElevation, lineColor, labelColor });
  }

  const wordEl = document.getElementById('hero-word');
  if (wordEl) startWordCycle(wordEl, words);
</script>
