---
// Recapiti (email, WhatsApp, Instagram, sede). variant "menu": lista
// compatta nel menu, con in più il Portfolio (PDF); "rows": righe grandi
// nella pagina Contatti.
import ContactValue from './ContactValue.astro';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  variant: 'menu' | 'rows';
}

const { lang, variant } = Astro.props;
const t = useTranslations(lang).contacts;
const items = [
  { label: t.email, kind: 'email' },
  { label: t.whatsapp, kind: 'wa' },
  { label: t.instagram, kind: 'ig' },
  { label: t.location, kind: 'loc' },
] as const;
const menuItems = [...items, { label: t.portfolio, kind: 'pdf' } as const];
---

{
  variant === 'menu' ? (
    <dl class="menu-contacts">
      {menuItems.map(({ label, kind }) => (
        <div>
          <dt>{label}</dt>
          <dd>
            <ContactValue kind={kind} lang={lang} />
          </dd>
        </div>
      ))}
    </dl>
  ) : (
    <ul class="rows rows-info">
      {items.map(({ label, kind }) => (
        <li>
          <span class="num">{label}</span>
          <p>
            <ContactValue kind={kind} lang={lang} />
          </p>
        </li>
      ))}
    </ul>
  )
}
