---

<div class="veil" id="veil" aria-hidden="true">
  <div class="veil__ring">
    <svg viewBox="0 0 150 150" class="veil__svg">
      <circle cx="75" cy="75" r="70" fill="none" stroke="rgba(255,255,255,0.16)" stroke-width="1.5"></circle>
      <circle
        id="veil-progress"
        cx="75"
        cy="75"
        r="70"
        fill="none"
        stroke="#ffffff"
        stroke-width="1.5"
        stroke-linecap="round"
        class="veil__progress"
      ></circle>
    </svg>
    <span class="veil__glyph">✣</span>
  </div>
</div>

<style>
  .veil {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000000;
  }

  .veil.is-fading {
    animation: veilOut 0.55s ease forwards;
  }

  .veil.is-done {
    display: none;
  }

  .veil__ring {
    position: relative;
    width: 150px;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .veil__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .veil__progress {
    stroke-dasharray: 439.8;
    stroke-dashoffset: 439.8;
    transition: stroke-dashoffset 0.4s ease;
  }

  .veil__glyph {
    font-size: 72px;
    line-height: 1;
    color: #ffffff;
    opacity: 0.9;
    animation: glyphSpin 1.6s linear infinite;
  }
</style>

<script>
  import { initVeil } from '../lib/veil';

  const overlay = document.getElementById('veil');
  const progressCircle = document.getElementById('veil-progress');
  // La lista deriva dal DOM (currentSrc, già risolto dal browser in base a
  // srcset/sizes) così il preload richiede esattamente la variante
  // responsive che verrà davvero mostrata, senza doppie richieste.
  const photoSrcs = Array.from(document.querySelectorAll<HTMLImageElement>('#flow img'))
    .map((img) => img.currentSrc || img.getAttribute('src') || '')
    .filter(Boolean);

  if (overlay && progressCircle) {
    initVeil({ overlay, progressCircle: progressCircle as unknown as SVGCircleElement }, photoSrcs);
  }
</script>
