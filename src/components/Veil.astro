<div class="veil" id="veil" aria-hidden="true">
  <span class="veil__glyph">✣</span>
</div>

<style>
  .veil {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000000;
  }

  .veil.is-fading {
    animation: veilOut 0.55s ease forwards;
  }

  .veil.is-done {
    display: none;
  }

  .veil__glyph {
    font-size: 72px;
    line-height: 1;
    color: #ffffff;
    opacity: 0.9;
    animation: glyphSpin 1.6s linear infinite;
  }
</style>

<script>
  import { initVeil } from '../lib/veil';

  const overlay = document.getElementById('veil');
  // La lista deriva dal DOM (currentSrc, già risolto dal browser in base a
  // srcset/sizes) così il preload richiede esattamente la variante
  // responsive che verrà davvero mostrata, senza doppie richieste.
  const photoSrcs = Array.from(document.querySelectorAll<HTMLImageElement>('#flow img'))
    .map((img) => img.currentSrc || img.getAttribute('src') || '')
    .filter(Boolean);

  if (overlay) {
    initVeil({ overlay }, photoSrcs);
  }
</script>
